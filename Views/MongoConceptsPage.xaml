<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HighFidelity.Ui.ViewModels"
             xmlns:models="clr-namespace:HighFidelity.Ui.Models"
             xmlns:converters="clr-namespace:HighFidelity.Ui.Converters"
             xmlns:views="clr-namespace:HighFidelity.Ui.Views"
             x:Class="HighFidelity.Ui.Views.MongoConceptsPage"
             x:DataType="vm:MongoConceptsViewModel"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <converters:StatusBackgroundConverter x:Key="StatusBackgroundConverter" />

        <!--
            One DataTemplate per ConceptResultKind, selected by ConceptCardTemplateSelector
            (see code-behind). Each card in the list builds exactly ONE of these — not all
            of them stacked with IsVisible toggles. The first version did that (8 nested
            BindableLayouts per card x 23 cards) and reliably crashed WinUI's native
            renderer during scroll; this is the fix, not a stylistic preference.
            Header markup (badge/topic/Run button/Note/status line) is duplicated across
            templates since MAUI has no template-composition mechanism — mechanical but safe.
        -->

        <DataTemplate x:Key="MessageCardTemplate" x:DataType="models:ConceptResultItem">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryOrange}" Stroke="Transparent" StrokeShape="RoundRectangle 3" Padding="8,3" VerticalOptions="Center">
                            <Label Text="{Binding MethodLabel}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding Topic}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Margin="10,0,0,0" TextColor="{StaticResource TextPrimary}" />
                        <Button Grid.Column="2" Text="Run" Command="{Binding RunCommand}" FontSize="12" Padding="14,6" />
                    </Grid>
                    <Label Text="{Binding Note}" FontSize="10" TextColor="{StaticResource TextLight}" LineBreakMode="WordWrap" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                    <Label Text="{Binding StatusLine}" FontSize="10" TextColor="{StaticResource TextLight}" />
                    <Label Text="{Binding ResultText}" FontSize="10" FontFamily="Courier" LineBreakMode="WordWrap" TextColor="{StaticResource TextPrimary}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                                <Setter Property="TextColor" Value="#F7284A" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OrdersCardTemplate" x:DataType="models:ConceptResultItem">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryOrange}" Stroke="Transparent" StrokeShape="RoundRectangle 3" Padding="8,3" VerticalOptions="Center">
                            <Label Text="{Binding MethodLabel}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding Topic}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Margin="10,0,0,0" TextColor="{StaticResource TextPrimary}" />
                        <Button Grid.Column="2" Text="Run" Command="{Binding RunCommand}" FontSize="12" Padding="14,6" />
                    </Grid>
                    <Label Text="{Binding Note}" FontSize="10" TextColor="{StaticResource TextLight}" LineBreakMode="WordWrap" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                    <Label Text="{Binding StatusLine}" FontSize="10" TextColor="{StaticResource TextLight}" />
                    <Label Text="{Binding PagedInfo}" IsVisible="{Binding HasPagedInfo}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />

                    <VerticalStackLayout IsVisible="{Binding HasOrders}" Spacing="0">
                        <Border BackgroundColor="{StaticResource TableHeaderBg}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="10,8">
                            <Grid ColumnDefinitions="70,*,110,80,90">
                                <Label Text="INVOICE" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="1" Text="CUSTOMER" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="2" Text="COUNTRY" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="3" Text="PRICE" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeaderLabel}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:OrderRow">
                                    <Grid RowDefinitions="*,1" Padding="10,0">
                                        <Grid ColumnDefinitions="70,*,110,80,90" HeightRequest="38">
                                            <Label Text="{Binding Invoice}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Customer}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Country}" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding Price, StringFormat='${0:F0}'}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Border Grid.Column="4" BackgroundColor="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}" Stroke="Transparent" StrokeShape="RoundRectangle 3" WidthRequest="64" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                                <Label Text="{Binding Status}" FontSize="9" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource DividerColor}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding ResultText}" IsVisible="{Binding ShowRawFallback}" FontSize="10" FontFamily="Courier" LineBreakMode="WordWrap" TextColor="{StaticResource TextPrimary}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                                <Setter Property="TextColor" Value="#F7284A" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

