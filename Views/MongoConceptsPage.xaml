                        </Border>
                        <Label Grid.Column="1" Text="{Binding Topic}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Margin="10,0,0,0" TextColor="{StaticResource TextPrimary}" />
                        <Button Grid.Column="2" Text="Run" Command="{Binding RunCommand}" FontSize="12" Padding="14,6" />
                    </Grid>
                    <Label Text="{Binding Note}" FontSize="10" TextColor="{StaticResource TextLight}" LineBreakMode="WordWrap" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                    <Label Text="{Binding StatusLine}" FontSize="10" TextColor="{StaticResource TextLight}" />

                    <VerticalStackLayout IsVisible="{Binding HasUnpivotRows}" Spacing="0">
                        <Border BackgroundColor="{StaticResource TableHeaderBg}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="10,8">
                            <Grid ColumnDefinitions="*,*,70">
                                <Label Text="COUNTRY" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="1" Text="STATUS" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="2" Text="COUNT" Style="{StaticResource TableHeaderLabel}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding UnpivotRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UnpivotRow">
                                    <Grid RowDefinitions="*,1" Padding="10,0">
                                        <Grid ColumnDefinitions="*,*,70" HeightRequest="30">
                                            <Label Text="{Binding Country}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Status}" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Count}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" HorizontalOptions="Center" />
                                        </Grid>
                                        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource DividerColor}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding ResultText}" IsVisible="{Binding ShowRawFallback}" FontSize="10" FontFamily="Courier" LineBreakMode="WordWrap" TextColor="{StaticResource TextPrimary}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                                <Setter Property="TextColor" Value="#F7284A" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FacetCardTemplate" x:DataType="models:ConceptResultItem">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryOrange}" Stroke="Transparent" StrokeShape="RoundRectangle 3" Padding="8,3" VerticalOptions="Center">
                            <Label Text="{Binding MethodLabel}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding Topic}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Margin="10,0,0,0" TextColor="{StaticResource TextPrimary}" />
                        <Button Grid.Column="2" Text="Run" Command="{Binding RunCommand}" FontSize="12" Padding="14,6" />
                    </Grid>
                    <Label Text="{Binding Note}" FontSize="10" TextColor="{StaticResource TextLight}" LineBreakMode="WordWrap" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                    <Label Text="{Binding StatusLine}" FontSize="10" TextColor="{StaticResource TextLight}" />

                    <!-- Facet is the one card combining three shapes, so it alone gets section captions. -->
                    <Label Text="Top orders by price" IsVisible="{Binding HasOrders}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <VerticalStackLayout IsVisible="{Binding HasOrders}" Spacing="0">
                        <Border BackgroundColor="{StaticResource TableHeaderBg}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="10,8">
                            <Grid ColumnDefinitions="70,*,110,80,90">
                                <Label Text="INVOICE" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="1" Text="CUSTOMER" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="2" Text="COUNTRY" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="3" Text="PRICE" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeaderLabel}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:OrderRow">
                                    <Grid RowDefinitions="*,1" Padding="10,0">
                                        <Grid ColumnDefinitions="70,*,110,80,90" HeightRequest="34">
                                            <Label Text="{Binding Invoice}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Customer}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Country}" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding Price, StringFormat='${0:F0}'}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Border Grid.Column="4" BackgroundColor="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}" Stroke="Transparent" StrokeShape="RoundRectangle 3" WidthRequest="64" HeightRequest="22" HorizontalOptions="Start" VerticalOptions="Center">
                                                <Label Text="{Binding Status}" FontSize="9" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource DividerColor}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="Revenue by country" IsVisible="{Binding HasCountryRevenues}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <VerticalStackLayout IsVisible="{Binding HasCountryRevenues}" Spacing="0">
                        <Border BackgroundColor="{StaticResource TableHeaderBg}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="10,8">
                            <Grid ColumnDefinitions="*,100,130">
                                <Label Text="COUNTRY" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="1" Text="ORDERS" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="2" Text="TOTAL REVENUE" Style="{StaticResource TableHeaderLabel}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CountryRevenues}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CountryRevenueRow">
                                    <Grid RowDefinitions="*,1" Padding="10,0">
                                        <Grid ColumnDefinitions="*,100,130" HeightRequest="30">
                                            <Label Text="{Binding Country}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding OrderCount}" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding TotalRevenue, StringFormat='${0:F0}'}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource DividerColor}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="Order stats by country" IsVisible="{Binding HasCountryStats}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <VerticalStackLayout IsVisible="{Binding HasCountryStats}" Spacing="0">
                        <Border BackgroundColor="{StaticResource TableHeaderBg}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="10,8">
                            <Grid ColumnDefinitions="*,80,90,90,90">
                                <Label Text="COUNTRY" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="1" Text="ORDERS" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="2" Text="MIN" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="3" Text="MAX" Style="{StaticResource TableHeaderLabel}" />
                                <Label Grid.Column="4" Text="AVG" Style="{StaticResource TableHeaderLabel}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CountryStatsRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CountryStatsRow">
                                    <Grid RowDefinitions="*,1" Padding="10,0">
                                        <Grid ColumnDefinitions="*,80,90,90,90" HeightRequest="30">
                                            <Label Text="{Binding Country}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding OrderCount}" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding MinPrice, StringFormat='${0:F0}'}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding MaxPrice, StringFormat='${0:F0}'}" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            <Label Grid.Column="4" Text="{Binding AvgPrice, StringFormat='${0:F0}'}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource DividerColor}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding ResultText}" IsVisible="{Binding ShowRawFallback}" FontSize="10" FontFamily="Courier" LineBreakMode="WordWrap" TextColor="{StaticResource TextPrimary}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                                <Setter Property="TextColor" Value="#F7284A" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <views:ConceptCardTemplateSelector x:Key="ConceptCardTemplateSelector"
            MessageTemplate="{StaticResource MessageCardTemplate}"
            OrdersTemplate="{StaticResource OrdersCardTemplate}"
            CountryRevenueTemplate="{StaticResource CountryRevenueCardTemplate}"
            CountryStatsTemplate="{StaticResource CountryStatsCardTemplate}"
            RankedOrdersTemplate="{StaticResource RankedOrdersCardTemplate}"
            EmployeeChainTemplate="{StaticResource EmployeeChainCardTemplate}"
            CustomerInsightsTemplate="{StaticResource CustomerInsightsCardTemplate}"
            PivotTemplate="{StaticResource PivotCardTemplate}"
            UnpivotTemplate="{StaticResource UnpivotCardTemplate}"
            FacetTemplate="{StaticResource FacetCardTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="24,20,24,12" Spacing="8">
            <HorizontalStackLayout Spacing="4">
                <Button Text="← Back to Dashboard"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryOrange}"
                        FontSize="13"
                        Padding="0" />
            </HorizontalStackLayout>

            <Label Text="MongoDB Concepts"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
            <Label FontSize="11" TextColor="{StaticResource TextLight}">
                <Label.Text>One card per SQL interview topic implemented on feature/mongodbnoazure-advanced — tap Run on any card to call the real endpoint against the running backend. Each card renders its actual shape (a table, a ranked list, an org chart) rather than raw JSON, except explain() and status messages, which are genuinely better read as text.</Label.Text>
            </Label>

            <Button Text="Run all safe reads"
                    Command="{Binding RunAllSafeCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalOptions="Start"
                    Margin="0,8,0,0" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,0,24,24" Spacing="12"
                                 BindableLayout.ItemsSource="{Binding Items}"
                                 BindableLayout.ItemTemplateSelector="{StaticResource ConceptCardTemplateSelector}" />
        </ScrollView>
    </Grid>
</ContentPage>
