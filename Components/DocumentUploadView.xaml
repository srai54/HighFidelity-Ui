<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HighFidelity.Ui.Models"
             xmlns:conv="clr-namespace:HighFidelity.Ui.Converters"
             x:Class="HighFidelity.Ui.Components.DocumentUploadView"
             x:Name="DocumentSelf">
    <ContentView.Resources>
        <conv:DocumentStatusColorConverter x:Key="StatusColor" />
        <conv:DocumentStatusLabelConverter x:Key="StatusLabel" />
        <conv:IsGreaterThanZeroConverter x:Key="IsGreaterThanZero" />
        <conv:ContentTypeIconConverter x:Key="FileIcon" />
    </ContentView.Resources>
    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="Documents"
                       VerticalOptions="Center"
                       Style="{StaticResource SectionTitle}" />
                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <Label x:Name="StatusLabel"
                           Text="{Binding DocumentStatusSummary, Source={x:Reference DocumentSelf}}"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                    <Button Text="Upload Document"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="12"
                            Padding="14,8"
                            Command="{Binding UploadDocumentCommand, Source={x:Reference DocumentSelf}}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf0c7;" Color="White" Size="12" />
                        </Button.ImageSource>
                    </Button>
                </HorizontalStackLayout>
            </Grid>

            <!--
                A different signal from any single document's own "Failed" status
                badge below: this counts messages the Service Bus queue itself gave
                up on (see HighFidelity-Api's ServiceBusController/ServiceBusDeadLetterService).
                Hidden entirely when there's nothing dead-lettered.
            -->
            <Border BackgroundColor="#FFEBEE"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 4"
                    Padding="10,6"
                    IsVisible="{Binding DeadLetterCount, Source={x:Reference DocumentSelf}, Converter={StaticResource IsGreaterThanZero}}">
                <Label FontSize="11" TextColor="#C62828">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="&#xf071; " FontFamily="FontAwesome" />
                            <Span Text="{Binding DeadLetterCount, Source={x:Reference DocumentSelf}}" FontAttributes="Bold" />
                            <Span Text=" message(s) failed delivery and were moved to the dead-letter queue." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Border>

            <CollectionView ItemsSource="{Binding Documents, Source={x:Reference DocumentSelf}}"
                            HeightRequest="220"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No documents uploaded yet."
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DocumentModel">
                        <Border BackgroundColor="{StaticResource PageBackground}"
                                Padding="10,8"
                                Margin="0,2"
                                StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                <Border Grid.RowSpan="2"
                                        BackgroundColor="{StaticResource CardBackground}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="0"
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding ContentType, Converter={StaticResource FileIcon}}"
                                           FontFamily="FontAwesome"
                                           FontSize="13"
                                           TextColor="{StaticResource TextSecondary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding FileName}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1"
                                       Grid.Row="1"
                                       FontSize="10"
                                       TextColor="{StaticResource TextSecondary}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding FileSizeDisplay}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding UploadedDateDisplay}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- Processing status badge -->
                                <Border Grid.Column="2"
                                        Grid.RowSpan="2"
                                        BackgroundColor="{Binding ProcessingStatus, Converter={StaticResource StatusColor}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 3"
                                        Padding="6,2"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End">
                                    <Label Text="{Binding ProcessingStatus, Converter={StaticResource StatusLabel}}"
                                           FontSize="9"
                                           TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Border>
</ContentView>
